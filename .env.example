MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=erc8004
MONGO_DATABASE_ANALYZED_AGENTS=analyzed_agents

MONGO_COLLECTION_CONTRACTS=contracts
MONGO_COLLECTION_CRAWLERS=crawlers
MONGO_COLLECTION_EVENTS=events
MONGO_COLLECTION_OFFCHAIN_DATA=offchain_data
MONGO_COLLECTION_CONFIG=config
MONGO_COLLECTION_AGENTS=agents
MONGO_COLLECTION_IDENTITY_HISTORY=identity_history
MONGO_COLLECTION_SCORE_HISTORY=score_history
MONGO_COLLECTION_FEEDBACK_HISTORY=feedback_history
MONGO_COLLECTION_WALLETS=wallets

# EVM CRAWLER CONFIG

CRAWLER_BATCH_SIZE=1000
# Seconds between full crawl cycles when the last cycle succeeded (near head / "live" polling).
CRAWLER_POLL_SECONDS=20
# Backoff when the last cycle failed (Mongo list, any contract crawl error, MQ publish, etc.).
CRAWLER_ERROR_POLL_SECONDS=30
CRAWLER_RPC_TIMEOUT_SECONDS=15
# Max concurrent (chainId, contract) crawl jobs. Default 12 = all MVP pairs at once (6 chains × 2 contracts).
CRAWLER_MAX_CONCURRENCY=12
# Per-RPC: max retry rounds after the first failed request (then rotate to next URL in contracts.rpcs).
CRAWLER_RPC_MAX_RETRIES=3
# Backoff base delay between retries (linear/exponential/fibonacci scale from this; random uses [D, 2D)).
CRAWLER_RETRY_BACKOFF_MS=100
# linear | exponential | fibonacci | random
CRAWLER_RETRY_STRATEGY=linear

# RABBITMQ (localhost = run workers on host; docker-compose.yaml overrides to rabbitmq:5672 for stack services)
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=erc8004.raw_logs
RABBITMQ_URI_QUEUE=erc8004.agent_uri

# Consumer: number of unacked messages the consumer goroutine can hold at once.
CONSUMER_PREFETCH=10

# URI resolver (Stream 1): cron scan events, fetch URIs, save per-chain cursor.
URI_BOOTSTRAP_BATCH_SIZE=1000
URI_RESOLVER_INTERVAL_SECONDS=30

# Per-request timeout for HTTPS/IPFS gateway GET (whole dial+TLS+body). Default 90s for slow/cold hosts (e.g. Render).
HTTPS_FETCH_TIMEOUT_SECONDS=90
HTTPS_USER_AGENT=erc8004-uri-bootstrap/1.0

# TrustRank worker (Stream 2): cron scan events up to URI cursor per chain.
TRUSTRANK_INTERVAL_SECONDS=300
TRUSTRANK_EVENT_BATCH_SIZE=500

# TrustRank formula params (§3.1–§3.4)
TRUSTRANK_ALPHA=1.0
TRUSTRANK_BETA=1.5
TRUSTRANK_K=100.0
TRUSTRANK_TBASE_DAYS=15.0
PENALTY_GAMMA=5.0
PENALTY_THETA=2.0

# Decay cron interval (hours). Default: every 4 hours.
DECAY_INTERVAL_HOURS=4

# IPFS gateway for URI resolution
IPFS_GATEWAY=https://ipfs.io/ipfs/

# REST API (cmd/workers/api)
API_PORT=8080
API_READ_TIMEOUT_SECONDS=15
API_WRITE_TIMEOUT_SECONDS=30
API_SHUTDOWN_TIMEOUT_SECONDS=15
# Comma-separated list of allowed CORS origins, or "*" to allow all.
API_ALLOWED_ORIGINS=*
# Default TTL (seconds) for the in-memory API cache used by read-heavy endpoints.
API_CACHE_DEFAULT_TTL_SECONDS=60
# Required on all /admin/* endpoints as X-API-Key.
ADMIN_API_KEY=change-me

# REDIS (realtime Pub/Sub bridge between consumer and API WebSocket hub)
# Used to fan-out decoded events to connected WS clients. Safe to leave unset
# in environments where realtime isn't needed — the API will still serve REST.
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_CHANNEL=erc8004:events:realtime

# Composite score blend weights — must sum to 1.0 (checked at startup, warning logged if not).
SCORE_WEIGHT_REPUTATION=0.5
SCORE_WEIGHT_SERVICES=0.2
SCORE_WEIGHT_PUBLISHER=0.2
SCORE_WEIGHT_COMPLIANCE=0.1

# Compliance tier weights — must sum to 100.0 (checked at startup, warning logged if not).
COMPLIANCE_TIER1_WEIGHT=80.0
COMPLIANCE_TIER2_WEIGHT=20.0

# TRUST GRAPH FOUNDATION
TRUST_WEIGHT_COLD_START_T0=10
